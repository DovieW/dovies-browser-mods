{
  "manifest_version": 3,
  "version": "0.7.0",
  "name": "Dovie's Browser Mods",
  "description": "Simple Chrome extension that adds useful shortcuts.",
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "scripting",
    "offscreen",
    "clipboardWrite",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dovie's Browser Mods"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "127",
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_permissions": ["bookmarks"],
  "web_accessible_resources": [
    {
      "resources": [
        "launcher.html",
        "launcher.js",
        "workspace.css",
        "theme/*.css"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
